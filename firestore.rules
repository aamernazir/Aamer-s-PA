rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function approvedAccount() {
      return signedIn()
        && request.auth.token.email in [
          'aamernazir.an@gmail.com',
          'rajaaamer30@gmail.com'
        ];
    }

    function ownsNewData() {
      return request.resource.data.ownerUid == request.auth.uid;
    }

    function ownsExistingData() {
      return resource.data.ownerUid == request.auth.uid;
    }

    // Private module state: only the signed-in owner can access their data.
    match /users/{userId}/state/{key} {
      allow read, delete: if approvedAccount()
                         && request.auth.uid == userId;
      allow create, update: if approvedAccount()
                            && request.auth.uid == userId
                            && ownsNewData();
    }

    // Shared-state records remain owner-only until a deliberate sharing UI is added.
    match /shared_state/{key} {
      allow create: if approvedAccount() && ownsNewData();
      allow read, delete: if approvedAccount() && ownsExistingData();
      allow update: if approvedAccount()
                    && ownsExistingData()
                    && request.resource.data.ownerUid == request.auth.uid;
    }
  }
}
